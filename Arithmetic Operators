1. Arithmetic Operators

a, b = 20,10
c, d = 5,2
print("a+b = ",a+b)
print("a-b = ",a-b)
print("a*b = ",a*b)
print("c/d = ",c/d)
print("c**d = ",c**d)
print("c%d = ",c%d)
print("c//d = ",c//d)

Output

a+b =  30
a-b =  10
a*b =  200
c/d =  2.5
c**d =  25
c%d =  1
c//d =  2
