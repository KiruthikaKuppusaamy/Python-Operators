a = 5   # in binary: 0101
b = 3   # in binary: 0011

print("a & b =", a & b)   # 0101 & 0011 = 0001 (1)
print("a | b =", a | b)   # 0101 | 0011 = 0111 (7)
print("a ^ b =", a ^ b)   # 0101 ^ 0011 = 0110 (6)
print("~a =", ~a)         # complement of 0101 = 1010 (in 2's complement, -6)
print("a << 1 =", a << 1) # 0101 << 1 = 1010 (10)
print("a >> 1 =", a >> 1) # 0101 >> 1 = 0010 (2)


Output

a & b = 1
a | b = 7
a ^ b = 6
~a = -6
a << 1 = 10
a >> 1 = 2
